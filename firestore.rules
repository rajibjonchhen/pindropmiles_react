rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/main {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid in ["TlqMfAIQ9BcWsThPMQ5T0qpHkyw1"];
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}